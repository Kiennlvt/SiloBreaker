SB_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/silobreaker
# offline = deterministic rule-based extractor (no key). openai = model-backed extractor
# (pip install -e ".[ai]" and set SB_OPENAI_API_KEY; missing key -> 503 provider_not_configured).
SB_AI_PROVIDER=offline
# SB_OPENAI_API_KEY=
# SB_OPENAI_MODEL=gpt-4.1-mini
# SB_AI_TIMEOUT_SECONDS=60
# SB_AI_MAX_RETRIES=2
# SB_AI_MAX_CALLS_PER_STAGE=3
